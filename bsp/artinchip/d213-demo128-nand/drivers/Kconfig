menu "On-chip Peripheral Drivers"

config BSP_USING_GPIO
    bool "Enable GPIO / pin device"
    default y
    select RT_USING_PIN
    help
        Enables the standard RT-Thread pin device ("gpio") on top of the
        ArtInChip GPIO HAL.  Pin names use the PA.n ... PH.n form.

menu "UART"

config BSP_USING_UART0
    bool "Enable UART0 (console)"
    default y
    select RT_USING_SERIAL

config BSP_USING_UART1
    bool "Enable UART1 (PA.4/PA.5)"
    default y
    select RT_USING_SERIAL

config BSP_USING_UART2
    bool "Enable UART2 (PA.8/PA.9, shared with I2C2)"
    default n
    select RT_USING_SERIAL

config BSP_USING_UART3
    bool "Enable UART3 (board pinmux required)"
    default n
    select RT_USING_SERIAL

config BSP_USING_UART4
    bool "Enable UART4 (PB.6/PB.7, shared with SDMC0/QSPI0)"
    default n
    select RT_USING_SERIAL

config BSP_USING_UART5
    bool "Enable UART5 (board pinmux required)"
    default n
    select RT_USING_SERIAL

config BSP_USING_UART6
    bool "Enable UART6 (board pinmux required)"
    default n
    select RT_USING_SERIAL

config BSP_USING_UART7
    bool "Enable UART7 (board pinmux required)"
    default n
    select RT_USING_SERIAL

endmenu

