from building import *

import os
import subprocess
import sys

cwd = GetCurrentDir()
src = []
CPPPATH = [cwd, cwd + '/../board', cwd + '/../vendor/include']

if (GetDepend('BSP_USING_UART0') or GetDepend('BSP_USING_UART1') or
        GetDepend('BSP_USING_UART2') or GetDepend('BSP_USING_UART3') or
        GetDepend('BSP_USING_UART4') or GetDepend('BSP_USING_UART5') or
        GetDepend('BSP_USING_UART6') or GetDepend('BSP_USING_UART7')):
    src += ['drv_uart.c']

if GetDepend('BSP_USING_GPIO'):
    src += ['drv_gpio.c']

if (GetDepend('BSP_USING_I2C0') or GetDepend('BSP_USING_I2C1') or
        GetDepend('BSP_USING_I2C2') or GetDepend('BSP_USING_I2C3')):
    src += ['drv_i2c.c']

if GetDepend('BSP_USING_TOUCH_GT911'):
    src += ['drv_touch_gt911.c']

if GetDepend('BSP_USING_CAN0') or GetDepend('BSP_USING_CAN1'):
    src += ['drv_can.c']

if GetDepend('BSP_USING_PWM'):
    src += ['drv_pwm.c']

if GetDepend('BSP_USING_WDT'):
    src += ['drv_wdt.c']

if GetDepend('BSP_USING_RTC'):
    src += ['drv_rtc.c']

if GetDepend('BSP_USING_DISPLAY'):
    src += ['drv_disp.c']

if GetDepend('BSP_USING_GE'):
    src += ['drv_ge.c']

if GetDepend('BSP_USING_QSPI0'):
    src += ['drv_qspi.c']

if GetDepend('BSP_USING_SPINAND_MTD_NAND'):
    # The partition table is generated from pack/image_cfg.json so the
    # driver never keeps a second copy of the NAND layout.
    gen = os.path.normpath(os.path.join(cwd, '..', 'tools', 'gen_nand_parts.py'))
    gen_dir = os.path.normpath(os.path.join(cwd, '..', 'build'))
    gen_out = os.path.join(gen_dir, 'spinand_parts_gen.h')
    subprocess.check_call([sys.executable, gen, '--output', gen_out])
    CPPPATH += [gen_dir]
    src += ['drv_spinand.c']

group = DefineGroup('Drivers', src, depend=[''], CPPPATH=CPPPATH)

Return('group')
