# Board options
#
CONFIG_AIC_DRAM_TOTAL_SIZE=0x8000000
CONFIG_AIC_BOOTLOADER_RESERVED_SIZE=0x800000
CONFIG_BSP_UART_CLK_FREQ=48000000
CONFIG_BSP_CLINT_FREQ=4000000
# end of Board options

#
# Testing
#
CONFIG_BSP_USING_UTEST=y
# CONFIG_BSP_UTEST_CAN_LOOPBACK is not set
# end of Testing

#
# On-chip Peripheral Drivers
#
CONFIG_BSP_USING_GPIO=y

#
# UART
#
CONFIG_BSP_USING_UART0=y
CONFIG_BSP_USING_UART1=y
# CONFIG_BSP_USING_UART2 is not set
# CONFIG_BSP_USING_UART3 is not set
# CONFIG_BSP_USING_UART4 is not set
# CONFIG_BSP_USING_UART5 is not set
