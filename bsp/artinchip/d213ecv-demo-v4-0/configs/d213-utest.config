CONFIG_BSP_I2C3_SPEED=400000
# CONFIG_BSP_I2C3_10BIT is not set
# end of I2C

#
# ADC (GPAI)
#
CONFIG_BSP_USING_GPAI6=y
CONFIG_BSP_GPAI6_ADC_ACQ=0x2f
